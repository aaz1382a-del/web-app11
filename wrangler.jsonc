{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app11",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a16a8225-d6b4-4a50-bb05-65f7be9c632e","database_name": "web-app1521421242" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5a7ad22efde34cde9b0b0c6725067baf" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
